{
    "name": "ckb-tx-rocket",
    "version": "1.0.0",
    "private": true,
    "description": "CKB Transaction Rocket - A monorepo containing blockchain visualization web app and NestJS backend",
    "author": "Sonny",
    "license": "MIT",
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "pnpm --filter @ckb-tx-rocket/web dev & pnpm --filter @ckb-tx-rocket/server start:dev",
        "dev:web": "pnpm --filter @ckb-tx-rocket/web dev",
        "dev:server": "pnpm --filter @ckb-tx-rocket/server start:dev",
        "build": "pnpm --filter @ckb-tx-rocket/web build && pnpm --filter @ckb-tx-rocket/server build",
        "build:web": "pnpm --filter @ckb-tx-rocket/web build",
        "build:server": "pnpm --filter @ckb-tx-rocket/server build",
        "start:server": "pnpm --filter @ckb-tx-rocket/server start:prod",
        "lint": "pnpm -r lint",
        "test": "pnpm -r test",
        "clean": "pnpm -r exec rm -rf dist node_modules",
        "install:all": "pnpm install"
    },
    "devDependencies": {
        "typescript": "~5.7.3"
    },
    "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
