# Database Configuration
DATABASE_URL="file:./prisma/database.db"

# CKB Network Configuration
CKB_NETWORK_TYPE="testnet"
CKB_HTTP_RPC_URL="https://testnet.ckb.dev/"
CKB_WS_RPC_URL="wss://testnet.ckb.dev/ws"

# Log Level Configuration
# Available levels: error, warn, log, debug, verbose
# Multiple levels can be combined with commas
# Examples:
#   LOG_LEVEL="error,warn,log"              # Default: No debug info
#   LOG_LEVEL="error,warn,log,debug"        # With debug info
#   LOG_LEVEL="error,warn,log,debug,verbose" # Full verbose logging
LOG_LEVEL="error,warn,log"

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS Configuration
# Update this to match your frontend URL
CORS_ORIGIN=http://localhost:8080
