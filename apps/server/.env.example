# Database Configuration
# SQLite database URL - using relative path from server directory
DATABASE_URL="file:./prisma/database.db"

# CKB Node Configuration
# Network type: mainnet or testnet
CKB_NETWORK_TYPE=testnet

# CKB RPC URLs
# For testnet (default):
CKB_HTTP_RPC_URL=https://testnet.ckb.dev/
CKB_WS_RPC_URL=wss://testnet.ckb.dev/ws

# For local CKB node:
# CKB_HTTP_RPC_URL=http://127.0.0.1:8114
# CKB_WS_RPC_URL=ws://127.0.0.1:28114

# For mainnet:
# CKB_NETWORK_TYPE=mainnet
# CKB_HTTP_RPC_URL=https://mainnet.ckb.dev/
# CKB_WS_RPC_URL=wss://mainnet.ckb.dev/ws

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS Configuration
# Update this to match your frontend URL
CORS_ORIGIN=http://localhost:8080
