# Prisma database URL (required for prisma commands)
# This will be overridden at runtime by PrismaService based on NETWORK env var
DATABASE_URL="file:./ckb-testnet.db"

# Mainnet Configuration
MAINNET_DATABASE_FILE="./ckb-mainnet.db"
MAINNET_WS_RPC_URL="wss://mainnet.ckb.dev/ws"
MAINNET_HTTP_RPC_URL="https://mainnet.ckb.dev"
API_MAINNET_PORT=3001

# Testnet Configuration
TESTNET_DATABASE_FILE="./ckb-testnet.db"
TESTNET_WS_RPC_URL="wss://testnet.ckb.dev/ws"
TESTNET_HTTP_RPC_URL="https://testnet.ckb.dev"
API_TESTNET_PORT=3000
   